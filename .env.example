# Copy this file to .env.local and fill in the values. .env.local is not committed.
# Variables prefixed with EXPO_PUBLIC_ are bundled into the app and can be extracted
# from it: never put a secret in one (for Stripe, only the pk_ key, never an sk_ key).

# Build identity (app.config.ts)
APP_NAME=
UNIQUE_IDENTIFIER=

# Android push notifications: path to the Firebase project's google-services.json
# (Firebase console > Project settings > Your apps > Android). Optional: without it
# the app builds, but Android can't get a push token. On EAS, a file variable.
GOOGLE_SERVICES_JSON=

# iOS Firebase app, for Remote Config: path to the same project's GoogleService-Info.plist
# (Firebase console > Project settings > Your apps > iOS). Optional: without it the app builds and
# runs, and the feature flags keep their defaults. On EAS, a file variable.
GOOGLE_SERVICE_INFO_PLIST=

# API: GraphQL endpoint, production or local
EXPO_PUBLIC_API_URL=

# Firebase Auth: Firebase console > Project settings > Your apps
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=

# Stripe: test mode publishable key (pk_test_...) and Apple Pay merchant id
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_STRIPE_MERCHANT_ID=

# Google Maps and Places: address screen
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Feature flags: pins flags to fixed values in test builds, as a JSON object of flag key to value,
# for example {"checkout_banner":"Free shipping"}. They win over GrowthBook and Remote Config.
# Leave it empty everywhere else, production included.
FLAG_OVERRIDES=
