# Copy this file to .env.local and fill in the values. .env.local is not committed.
# Variables prefixed with EXPO_PUBLIC_ are bundled into the app and can be extracted
# from it: never put a secret in one (for Stripe, only the pk_ key, never an sk_ key).

# Build identity (app.config.ts)
APP_NAME=
UNIQUE_IDENTIFIER=

# API: GraphQL endpoint, production or local
EXPO_PUBLIC_API_URL=

# Firebase Auth: Firebase console > Project settings > Your apps
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=

# Stripe: test mode publishable key (pk_test_...) and Apple Pay merchant id
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_STRIPE_MERCHANT_ID=

# Google Maps and Places: address screen
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
