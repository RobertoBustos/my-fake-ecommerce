# Copy to .maestro/.env.e2e (ignored by git) and fill it in.
# Maestro reads every environment variable that starts with MAESTRO_.
# In CI the same names come from the repository's variables and secrets.
# The scripts load this file with sh: put any value with a $ in single quotes
# ('MX$109.95'), or sh expands it.

# Bundle id / package of the build under test: the UNIQUE_IDENTIFIER the app was built with.
MAESTRO_APP_ID=

# Test users created in production for E2E: E2E_EMAIL, E2E_PASSWORD,
# E2E_OTHER_EMAIL and E2E_OTHER_PASSWORD in the API repo's .env.e2e.
MAESTRO_EMAIL=
MAESTRO_PASSWORD=
MAESTRO_OTHER_EMAIL=
MAESTRO_OTHER_PASSWORD=

# Dedicated test product: E2E_PRODUCT_ID (its global id) in the API repo's .env.e2e,
# and its title and unit price exactly as the app shows them.
MAESTRO_PRODUCT_ID=
MAESTRO_PRODUCT_TITLE=
MAESTRO_PRODUCT_PRICE=

# Units of the test product the flows put in the order, and the order amounts
# for that quantity, exactly as the checkout summary shows them.
MAESTRO_ORDER_QUANTITY=
MAESTRO_EXPECTED_SUBTOTAL=
MAESTRO_EXPECTED_TAXES=
MAESTRO_EXPECTED_TOTAL=

# Stripe test card for the Payment Sheet (Stripe's published test values).
MAESTRO_CARD_NUMBER=
MAESTRO_CARD_EXPIRY=
MAESTRO_CARD_CVC=
