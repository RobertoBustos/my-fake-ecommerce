# Copy to .maestro/.env.e2e (ignored by git) and fill it in.
# Maestro reads every environment variable that starts with MAESTRO_.
# In CI the same names come from the repository's variables and secrets.

# Bundle id / package of the build under test: the UNIQUE_IDENTIFIER the app was built with.
MAESTRO_APP_ID=

# Test users created in production for E2E (the E2E_* values of the API repo).
MAESTRO_EMAIL=
MAESTRO_PASSWORD=
MAESTRO_OTHER_EMAIL=
MAESTRO_OTHER_PASSWORD=

# Dedicated test product: its id and the values the flows expect to see.
MAESTRO_PRODUCT_ID=
MAESTRO_PRODUCT_TITLE=
MAESTRO_PRODUCT_PRICE=

# Expected order amounts, as the app shows them (for example MX$109.95).
MAESTRO_EXPECTED_SUBTOTAL=
MAESTRO_EXPECTED_TAXES=
MAESTRO_EXPECTED_TOTAL=

# Stripe test card for the Payment Sheet.
MAESTRO_CARD_NUMBER=
MAESTRO_CARD_EXPIRY=
MAESTRO_CARD_CVC=
