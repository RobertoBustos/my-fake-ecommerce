{
  "cli": {
    "version": ">= 16.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development-android": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "development-ios-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview-android": {
      "distribution": "internal",
      "autoIncrement": true,
      "environment": "preview"
    },
    "preview-ios-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
