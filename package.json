{
  "name": "my-fake-ecommerce",
  "main": "index.ts",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --clear",
    "dev": "eval $(grep '^NODE_ENV' .env.dev) && npm run start",
    "build-dev-android": "eas build --platform android --profile development-android",
    "build-dev-ios": "eas build --platform ios --profile development-ios-simulator",
    "build-dev": "npm run build-dev-android && npm run build-dev-ios-simulator",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "e2e": "set -a && . ./.maestro/.env.e2e && set +a && maestro test .maestro --debug-output .maestro/results",
    "e2e:smoke": "set -a && . ./.maestro/.env.e2e && set +a && maestro test .maestro --debug-output .maestro/results --include-tags smoke"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "react-native-unistyles/mocks",
      "./app/styles/config/unistyles.ts"
    ],
    "moduleNameMapper": {
      "^immer$": "<rootDir>/node_modules/immer/dist/cjs/index.js"
    }
  },
  "dependencies": {
    "@apollo/client": "^4.3.8",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^7.0.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "@reduxjs/toolkit": "^2.14.0",
    "@stripe/stripe-react-native": "0.82.0",
    "expo": "~58.0.25",
    "expo-blur": "~58.0.6",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "firebase": "^13.4.0",
    "graphql": "^17.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "^2.1.0",
    "react-native-google-places-autocomplete": "^2.6.5",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-maps": "1.29.11",
    "react-native-nitro-modules": "0.37.2",
    "react-native-reanimated": "4.7.1",
    "react-native-root-toast": "^4.0.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-unistyles": "3.8.2",
    "react-native-web": "^0.21.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "react-redux": "^9.3.1",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "reactotron-react-native": "^5.3.1",
    "reactotron-redux": "^3.2.1",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@stripe/stripe-react-native"
      ]
    }
  },
  "private": true
}
