{
  "name": "my-fake-ecommerce",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --clear",
    "dev": "eval $(grep '^NODE_ENV' .env.dev) && npm run start",
    "build-dev-android": "eas build --platform android --profile development-android",
    "build-dev-ios": "eas build --platform ios --profile development-ios-simulator",
    "build-dev": "npm run build-dev-android && npm run build-dev-ios-simulator",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "e2e": "set -a && . ./.maestro/.env.e2e && set +a && maestro test .maestro --debug-output .maestro/results",
    "e2e:smoke": "set -a && . ./.maestro/.env.e2e && set +a && maestro test .maestro --debug-output .maestro/results --include-tags smoke",
    "postinstall": "patch-package"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@apollo/client": "^4.3.8",
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^7.0.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@reduxjs/toolkit": "^2.6.0",
    "@stripe/stripe-react-native": "0.50.3",
    "expo": "~54.0.38",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "firebase": "^12.19.0",
    "graphql": "^16.10.0",
    "query-string": "^7.1.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.92.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-google-places-autocomplete": "^2.6.5",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-root-toast": "^3.6.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-unistyles": "^2.31.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "react-redux": "^9.2.0",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "^18.0.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.13.8",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.2.1",
    "jest-expo": "~54.0.18",
    "patch-package": "^8.0.0",
    "react-test-renderer": "19.1.0",
    "reactotron-react-native": "^5.1.12",
    "reactotron-redux": "^3.1.11",
    "typescript": "~5.9.2"
  },
  "private": true
}
