{
  "name": "my-fake-ecommerce",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --clear",
    "dev": "eval $(grep '^NODE_ENV' .env.dev) && npm run start",
    "build-dev-android": "eas build --platform android --profile development-android",
    "build-dev-ios": "eas build --platform ios --profile development-ios-simulator",
    "build-dev": "npm run build-dev-android && npm run build-dev-ios-simulator",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "e2e": "set -a && . ./.maestro/.env.e2e && set +a && maestro test .maestro --debug-output .maestro/results",
    "e2e:smoke": "set -a && . ./.maestro/.env.e2e && set +a && maestro test .maestro --debug-output .maestro/results --include-tags smoke",
    "postinstall": "patch-package"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@apollo/client": "^4.3.8",
    "@expo/vector-icons": "^14.1.0",
    "@hookform/resolvers": "^7.0.6",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@reduxjs/toolkit": "^2.6.0",
    "@stripe/stripe-react-native": "0.45.0",
    "expo": "~53.0.27",
    "expo-blur": "~14.1.5",
    "expo-constants": "~17.1.8",
    "expo-dev-client": "~5.2.4",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-linking": "~7.1.7",
    "expo-router": "~5.1.11",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.5",
    "expo-system-ui": "~5.0.11",
    "expo-web-browser": "~14.2.0",
    "firebase": "^12.19.0",
    "graphql": "^16.10.0",
    "query-string": "^7.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.92.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-google-places-autocomplete": "^2.6.5",
    "react-native-keyboard-controller": "^1.16.8",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~3.17.4",
    "react-native-root-toast": "^3.6.0",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-unistyles": "^2.31.0",
    "react-native-web": "^0.20.0",
    "react-native-webview": "13.13.5",
    "react-redux": "^9.2.0",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "^18.0.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.13.8",
    "@types/react": "~19.0.10",
    "@types/react-test-renderer": "^19.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~9.2.0",
    "jest": "^29.2.1",
    "jest-expo": "~53.0.14",
    "patch-package": "^8.0.0",
    "react-test-renderer": "19.0.0",
    "reactotron-react-native": "^5.1.12",
    "reactotron-redux": "^3.1.11",
    "typescript": "~5.8.3"
  },
  "private": true
}
