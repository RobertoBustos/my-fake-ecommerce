{
  "name": "my-fake-ecommerce",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --clear",
    "dev": "eval $(grep '^NODE_ENV' .env.dev) && npm run start",
    "build-dev-android": "eas build --platform android --profile development-android",
    "build-dev-ios": "eas build --platform ios --profile development-ios-simulator",
    "build-dev": "npm run build-dev-android && npm run build-dev-ios-simulator",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "e2e": "set -a && . ./.maestro/.env.e2e && set +a && maestro test .maestro --debug-output .maestro/results",
    "e2e:smoke": "set -a && . ./.maestro/.env.e2e && set +a && maestro test .maestro --debug-output .maestro/results --include-tags smoke",
    "postinstall": "patch-package"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "react-native-unistyles/mocks",
      "./app/styles/config/unistyles.ts"
    ]
  },
  "dependencies": {
    "@apollo/client": "^4.3.8",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^7.0.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@reduxjs/toolkit": "^2.6.0",
    "@stripe/stripe-react-native": "0.64.0",
    "expo": "~56.0.24",
    "expo-blur": "~56.0.4",
    "expo-build-properties": "~56.0.27",
    "expo-constants": "~56.0.27",
    "expo-dev-client": "~56.0.28",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-linking": "~56.0.19",
    "expo-router": "~56.2.22",
    "expo-splash-screen": "~56.0.16",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.7",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.6",
    "firebase": "^12.19.0",
    "graphql": "^16.10.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.92.0",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-get-random-values": "^1.11.0",
    "react-native-google-places-autocomplete": "^2.6.5",
    "react-native-keyboard-controller": "1.21.6",
    "react-native-maps": "1.27.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.3.1",
    "react-native-root-toast": "^3.6.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-unistyles": "3.8.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "react-redux": "^9.2.0",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native-community/cli": "^18.0.0",
    "@react-native/jest-preset": "0.85.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.13.8",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "^29.2.1",
    "jest-expo": "~56.0.6",
    "patch-package": "^8.0.0",
    "react-test-renderer": "19.2.3",
    "reactotron-react-native": "^5.1.12",
    "reactotron-redux": "^3.1.11",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-community/geolocation"
        ]
      }
    }
  },
  "private": true
}
